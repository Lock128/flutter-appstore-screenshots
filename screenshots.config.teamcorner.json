{
  "url": "https://app.teamcorner.app",
  "outDir": "screenshots/teamcorner",
  "devices": [
    "iphone-6.9",
    "iphone-6.5",
    "ipad-13",
    "play-phone",
    "play-tablet-10"
  ],
  "locales": [
    "de-DE"
  ],
  "settleMs": 3000,
  "enableSemantics": true,
  "theme": "both",
  "navigationTimeoutMs": 120000,
  "actionTimeoutMs": 30000,
  "retries": 3,
  "login": {
    "path": "/login",
    "actions": [
      {
        "wait": 1500
      },
      {
        "type": "input[aria-label='E-Mail']",
        "text": "${SCREENSHOT_USER}"
      },
      {
        "type": "input[aria-label='Passwort']",
        "text": "${SCREENSHOT_PASSWORD}"
      },
      {
        "click": "text=/^Anmelden$/"
      }
    ],
    "waitFor": 6000
  },
  "screens": [
    {
      "name": "01-home",
      "path": "/"
    },
    {
      "name": "02-login",
      "path": "/login"
    },
    {
      "name": "03-register",
      "path": "/login",
      "actions": [
        {
          "click": "Konto erstellen"
        },
        {
          "wait": 800
        }
      ]
    },
    {
      "name": "05-forgot-password",
      "path": "/login",
      "actions": [
        {
          "click": "Passwort vergessen?"
        },
        {
          "wait": 800
        }
      ]
    },
    {
      "name": "06-games",
      "path": "/spiele",
      "waitFor": 2000
    },
