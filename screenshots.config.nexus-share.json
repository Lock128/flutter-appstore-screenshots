{
  "metadata": {
    "app": "nexus-share",
    "githubRepo": "https://github.com/Lock128/nexus-share",
    "flutterProject": "frontend/src",
    "flutterProjectPath": "nexus-share/frontend/src",
    "appUrl": "https://app.nexus-share.com",
    "note": "Routes taken from the app's router. Verify labels and routes against the current build."
  },
  "url": "https://app.nexus-share.com",
  "outDir": "screenshots/nexus-share",
  "devices": [
    "iphone-6.3",
    "iphone-6.1",
    "ipad-13",
    "play-phone",
    "play-tablet-10"
  ],
  "locales": [
    "en-US"
  ],
  "settleMs": 3000,
  "enableSemantics": true,
  "theme": "both",
  "navigationTimeoutMs": 120000,
  "actionTimeoutMs": 30000,
  "retries": 3,
  "login": {
    "path": "/login",
    "actions": [
      {
        "wait": 1500
      },
      {
        "type": "input[aria-label='Email']",
        "text": "${SCREENSHOT_USER}"
      },
      {
        "type": "input[aria-label='Password']",
        "text": "${SCREENSHOT_PASSWORD}"
      },
      {
        "click": "text=/^Sign In$/"
      }
    ],
    "waitFor": 6000
  },
  "screens": [
    {
      "name": "01-home",
      "path": "/",
      "waitFor": 2000
    },
    {
      "name": "02-landing",
      "path": "/landing",
      "waitFor": 2000
    },
    {
      "name": "03-login",
      "path": "/login",
      "waitFor": 2000
    },
    {
