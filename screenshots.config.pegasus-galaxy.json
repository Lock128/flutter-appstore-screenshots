{
  "metadata": {
    "app": "pegasus-galaxy",
    "githubRepo": "https://github.com/Lock128/pegasus-galaxy",
    "flutterProject": "frontend/src",
    "flutterProjectPath": "pegasus-galaxy/frontend/src",
    "appUrl": "https://app.pegasus-galaxy.net",
    "note": "Routes taken from the app's router. Verify labels and routes against the current build."
  },
  "url": "https://app.pegasus-galaxy.net",
  "outDir": "screenshots/pegasus-galaxy",
  "devices": [
    "iphone-6.3",
    "iphone-6.1",
    "ipad-13",
    "play-phone",
    "play-tablet-10"
  ],
  "locales": [
    "en-US"
  ],
  "settleMs": 3000,
  "enableSemantics": true,
  "theme": "both",
  "navigationTimeoutMs": 120000,
  "actionTimeoutMs": 30000,
  "retries": 3,
  "login": {
    "path": "#/signin",
    "actions": [
      {
        "wait": 1500
      },
      {
        "type": "input[aria-label='Email']",
        "text": "${SCREENSHOT_USER}"
      },
      {
        "type": "input[aria-label='Password']",
        "text": "${SCREENSHOT_PASSWORD}"
      },
      {
        "click": "Launch"
      }
    ],
    "waitFor": 6000
  },
  "screens": [
    {
      "name": "01-home",
      "path": "#/home",
      "waitFor": 2000
    },
