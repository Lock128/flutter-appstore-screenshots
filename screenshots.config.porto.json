{
  "metadata": {
    "app": "porto",
    "githubRepo": "https://github.com/Lock128/porto",
    "flutterProject": "frontend/src",
    "flutterProjectPath": "porto/frontend/src",
    "appUrl": "https://app.porto-app.eu",
    "note": "Routes taken from the app's router. Verify labels and routes against the current build."
  },
  "url": "https://app.porto-app.eu",
  "outDir": "screenshots/porto",
  "devices": [
    "iphone-6.9",
    "iphone-6.5",
    "ipad-13",
    "play-phone",
    "play-tablet-10"
  ],
  "locales": [
    "de-DE"
  ],
  "settleMs": 3000,
  "enableSemantics": true,
  "theme": "both",
  "navigationTimeoutMs": 120000,
  "actionTimeoutMs": 30000,
  "retries": 3,
  "login": {
    "path": "#/signin",
    "actions": [
      {
        "wait": 1500
      },
      {
        "type": "input[aria-label='E-Mail']",
        "text": "${SCREENSHOT_USER}"
      },
      {
        "type": "input[aria-label='Passwort']",
        "text": "${SCREENSHOT_PASSWORD}"
      },
      {
        "click": "text=/^Anmelden$/"
      }
    ],
    "waitFor": 6000
  },
  "screens": [
    {
      "name": "01-home",
      "path": "#/",
      "waitFor": 2000
    },
    {
      "name": "02-signin",
      "path": "#/signin",
      "waitFor": 2000
    },
    {
      "name": "03-register",
      "path": "#/register",
      "waitFor": 2000
    },
    {
      "name": "04-impressum",
      "path": "#/impressum",
      "waitFor": 2000
    },
    {
      "name": "05-agb",
      "path": "#/agb",
      "waitFor": 2000
    },
    {
      "name": "06-datenschutz",
      "path": "#/datenschutzerklaerung",
      "waitFor": 2000
    },
    {
      "name": "07-cookie-richtlinie",
      "path": "#/cookie-richtlinie",
      "waitFor": 2000
    },
    {
      "name": "20-book",
      "path": "#/book",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "21-rides",
      "path": "#/rides",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "22-profile",
      "path": "#/profile",
      "requiresLogin": true,
