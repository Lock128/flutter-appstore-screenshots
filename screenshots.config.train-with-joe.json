{
  "metadata": {
    "app": "train-with-joe",
    "githubRepo": "https://github.com/Lock128/train-with-joe",
    "flutterProject": "frontend/src",
    "flutterProjectPath": "train-with-joe/frontend/src",
    "appUrl": "https://app.trainwithjoe.app",
    "note": "Routes taken from the app's router. Verify labels and routes against the current build."
  },
  "url": "https://app.trainwithjoe.app",
  "outDir": "screenshots/train-with-joe",
  "devices": [
    "iphone-6.9",
    "iphone-6.5",
    "ipad-13",
    "play-phone",
    "play-tablet-10"
  ],
  "locales": [
    "en-US"
  ],
  "settleMs": 3000,
  "enableSemantics": true,
  "theme": "both",
  "navigationTimeoutMs": 120000,
  "actionTimeoutMs": 30000,
  "retries": 3,
  "login": {
    "path": "#/signin",
    "actions": [
      {
        "wait": 1500
      },
      {
        "type": "input[aria-label='Email']",
        "text": "${SCREENSHOT_USER}"
      },
      {
        "type": "input[aria-label='Password']",
        "text": "${SCREENSHOT_PASSWORD}"
      },
      {
        "click": "text=/^Sign In$/"
      }
    ],
    "waitFor": 6000
  },
  "screens": [
    {
      "name": "01-home",
      "path": "#/home",
      "waitFor": 2000
    },
    {
      "name": "02-signin",
      "path": "#/signin",
      "waitFor": 2000
    },
    {
      "name": "03-register",
      "path": "#/register",
      "waitFor": 2000
    },
    {
      "name": "04-reset-password",
      "path": "#/reset-password",
      "waitFor": 2000
    },
    {
      "name": "05-info",
      "path": "#/info",
      "waitFor": 2000
    },
    {
      "name": "06-impressum",
      "path": "#/impressum",
      "waitFor": 2000
    },
    {
      "name": "20-trainings",
      "path": "#/trainings",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "21-create-training",
      "path": "#/trainings/create",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "22-vocabulary",
      "path": "#/vocabulary",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "23-vocabulary-analyze",
      "path": "#/vocabulary/analyze",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "24-scan-translate",
      "path": "#/vocabulary/scan-translate",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "25-statistics",
      "path": "#/statistics",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "26-subscription",
      "path": "#/subscription",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "27-settings",
      "path": "#/settings",
      "requiresLogin": true,
      "waitFor": 2000
    },
    {
      "name": "28-admin",
      "path": "#/admin",
      "requiresLogin": true,
      "waitFor": 2000
    }
  ]
}
